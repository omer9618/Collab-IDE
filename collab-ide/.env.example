# ==============================================================================
# CollabIDE Backend Environment Configuration Template (NFR-49)
#
# IMPORTANT:
# Copy this file to `.env` and configure each environment variable.
# NEVER commit the actual `.env` file to source control.
# ALL production secrets must be generated with cryptographically secure PRNGs.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Runtime Environment
# ------------------------------------------------------------------------------
# Node runtime environment: 'development', 'production', or 'test'
NODE_ENV=development

# Server port to listen on (1 - 65535)
PORT=3000

# Base URL of frontend application (used for CORS and email verification redirects)
FRONTEND_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# 2. Database Connection & Connection Pooling (NFR-40)
# ------------------------------------------------------------------------------
# MongoDB connection URI (Atlas replica set or local MongoDB instance)
# Format: mongodb://user:pass@host:port/dbname or mongodb+srv://...
MONGODB_URI="mongodb://localhost:27017/collabide"

# Connection pool sizing (NFR-40):
# Pre-warmed idle connection floor
MONGO_MIN_POOL_SIZE=5
# Concurrency connection ceiling
MONGO_MAX_POOL_SIZE=20
# Idle connection eviction threshold in milliseconds (e.g. 30000 = 30 seconds)
MONGO_MAX_IDLE_TIME_MS=30000

# ------------------------------------------------------------------------------
# 3. Cryptographic Keys & Field-Level Encryption at Rest (NFR-22, NFR-49)
# ------------------------------------------------------------------------------
# Master 256-bit encryption key for AES-256-GCM field encryption at rest.
# Must be exactly 64 hexadecimal characters.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   or: openssl rand -hex 32
FIELD_ENCRYPTION_KEY=<generate-with-node:-crypto.randomBytes(32).toString('hex')>

# ------------------------------------------------------------------------------
# 4. Asymmetric RS256 JWT Authentication (NFR-11, NFR-17)
# ------------------------------------------------------------------------------
# Optional custom paths or direct PEM strings for RS256 JWT signing keypair.
# If omitted, keys are automatically resolved from .keys/private.pem and .keys/public.pem.
# JWT_PRIVATE_KEY_PATH=./.keys/private.pem
# JWT_PUBLIC_KEY_PATH=./.keys/public.pem
# Token expiry duration (e.g. 15m, 1h)
JWT_EXPIRES_IN=15m

# ------------------------------------------------------------------------------
# 5. WebRTC Voice Signalling & Coturn Relay (FR-53, NFR-30)
# ------------------------------------------------------------------------------
# Shared HMAC-SHA1 secret key for generating ephemeral TURN credentials.
# Must be at least 32 characters with sufficient entropy (256-bit recommended).
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   or: openssl rand -hex 32
TURN_SECRET=<generate-with-node:-crypto.randomBytes(32).toString('hex')>

# Primary STUN server URL
STUN_SERVER_URL=stun:stun.l.google.com:19302

# Custom TURN relay server URL (optional in development; uses Open Relay default)
TURN_SERVER_URL=turn:openrelay.metered.ca:80

# ------------------------------------------------------------------------------
# 6. Remote Code Execution Sandbox (Judge0 CE API)
# ------------------------------------------------------------------------------
# When true, uses in-memory simulated execution instead of contacting Judge0.
# When false, JUDGE0_API_URL and JUDGE0_API_KEY must be provided.
EXECUTION_MOCK_MODE=false

# Judge0 CE API endpoint (RapidAPI or self-hosted VPS instance per SC-01)
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com

# Judge0 / RapidAPI authentication key
JUDGE0_API_KEY=<your-rapidapi-judge0-api-key>

# ------------------------------------------------------------------------------
# 7. Authentication & Social Login
# ------------------------------------------------------------------------------
# Mock email verification tokens for local development/testing (true/false)
MOCK_EMAIL_VERIFICATION=true

# Google OAuth 2.0 Client ID (optional; used for Google Social Sign-In)
# GOOGLE_CLIENT_ID=<your-google-oauth-client-id>.apps.googleusercontent.com

# ------------------------------------------------------------------------------
# 8. Operational Concurrency & Lifecycle (NFR-36, NFR-38)
# ------------------------------------------------------------------------------
# Concurrency limit for active WebSockets per room (NFR-36)
MAX_WS_PER_ROOM=20

# Watchdog timeout for graceful process shutdown in milliseconds (NFR-38)
SHUTDOWN_TIMEOUT_MS=10000
