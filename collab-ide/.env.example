# CollabIDE Backend Environment Configuration Template

# Server Port
PORT=3000

# MongoDB Connection String (Atlas ReplicaSet or Local MongoDB)
MONGODB_URI="mongodb://localhost:27017/collabide"

# Authentication & Email Verification
MOCK_EMAIL_VERIFICATION=true

# Remote Code Execution Sandbox (Judge0 CE API)
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=your-rapidapi-judge0-key-here
EXECUTION_MOCK_MODE=false

# WebRTC Voice Signalling & STUN/TURN Relay (RFC 5766 / RFC 8489)
TURN_SECRET=your-turn-secret-hmac-key
STUN_SERVER_URL=stun:stun.l.google.com:19302
TURN_SERVER_URL=turn:openrelay.metered.ca:80

# Sensitive Field Encryption at Rest (NFR-22)
# 256-bit AES-256-GCM encryption key (64 hex characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FIELD_ENCRYPTION_KEY=your-256-bit-hex-encryption-key-here-64-characters
